{{#data-whale-live-recent}}
{{#has-live-recent}}
<div class="live-recent-stack">
	{{#feeds}}
		<div class="{{classes}}" data-live-recent-mode="{{mode}}" data-limit="{{limit}}" data-refresh-interval="{{refresh-ms}}" style="{{style}}">
			<section class="live-recent-feed is-active" id="{{panel-id}}" aria-labelledby="{{tab-id}}" data-namespaces="{{namespaces}}">
				<header class="live-recent-header">
					{{{ html-icon }}}
					<h2 class="live-recent-title" id="{{tab-id}}">{{heading}}</h2>
					{{{ html-more-link }}}
				</header>
				<div class="live-recent-progress" aria-hidden="true">
					<span class="live-recent-progress-bar"></span>
				</div>
				<ul class="live-recent-list" id="{{list-id}}" aria-busy="true"></ul>
			</section>
		</div>
	{{/feeds}}
</div>
{{/has-live-recent}}
{{/data-whale-live-recent}}
