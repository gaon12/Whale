{
	"name": "librewiki/whale-mw-skin",
	"description": "Whale MediaWiki Skin",
	"license": "GPL-3.0-or-later",
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "^51.0",
		"phpstan/phpstan": "^2.2"
	},
	"scripts": {
		"analyse": [
			"php -d memory_limit=256M vendor/phpstan/phpstan/phpstan.phar analyse --level=max --memory-limit=256M"
		],
		"test": [
			"php vendor/squizlabs/php_codesniffer/bin/phpcs -p -s",
			"@test:folding",
			"@test:tables",
			"@test:short-url",
			"@test:sections",
			"@test:mainpage",
			"@test:compatibility",
			"@test:avatar",
			"@test:navbar",
			"@test:renderers",
			"@test:theme-contrast"
		],
		"test:folding": [
			"php scripts/check-folding.php"
		],
		"test:tables": [
			"php scripts/check-table-decoration.php"
		],
		"test:short-url": [
			"php scripts/check-short-url.php"
		],
		"test:sections": [
			"php scripts/check-section-decoration.php"
		],
		"test:mainpage": [
			"php scripts/check-mainpage.php"
		],
		"test:compatibility": [
			"php scripts/check-compatibility.php"
		],
		"test:avatar": [
			"php scripts/check-avatar.php"
		],
		"test:navbar": [
			"php scripts/check-navbar.php"
		],
		"test:renderers": [
			"php scripts/check-renderer-behavior.php"
		],
		"test:theme-contrast": [
			"php scripts/check-theme-contrast.php"
		],
		"fix": "php vendor/squizlabs/php_codesniffer/bin/phpcbf"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require": {
		"php": ">=8.2",
		"dicebear/core": "^10.0",
		"dicebear/styles": "^10.1"
	}
}
